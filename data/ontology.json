   "approval": "불필요"
  },
  "RescheduleWorkOrder": {
   "ko": "작업지시 일정 변경",
   "description": "작업지시의 날짜나 설비를 바꾼다. 에이전트가 영향을 미리 계산하고 변경안을 올리면, 사람이 승인한 뒤에 실행된다.",
   "on": "WorkOrder",
   "role": "production_manager",
   "approval": "필요",
   "steps": [
    {
     "step": "미리보기",
     "mcp_tool": "preview_work_order_change",
     "by": "agent",
     "ko": "실행하지 않고 영향만 계산. 납기",
     "설비와 금형의 시간 겹침": null,
     "금형과 설비의 조합": null,
     "자재 가용량": null
    },
    {
     "step": "변경안 등록",
     "mcp_tool": "propose_work_order_change",
     "by": "agent"
    },
    {
     "step": "승인 또는 거절",
     "api": "POST /api/change-requests/{id}/approve",
     "by": "human",
     "ko": "도구가 아니다. 에이전트는 승인할 수 없다"
    },
    {
     "step": "실행",
     "mcp_tool": "execute_change",
     "by": "agent",
     "ko": "승인 기록이 없으면 MCP 서버가 거부한다"
    }
   ],
   "not_included": "수량 변경과 작업지시 취소는 넣지 않았다. 다른 구현이 끝난 뒤 다시 본다."
  },
  "InjectIncident": {
   "ko": "사건 주입",
